{
  "sap.app": {
    "id": "com.fal.arabian",
    "type": "application",
    "i18n": "i18n/i18n.properties",
    "title": "{{appTitle}}",
    "description": "{{appDescription}}",
    "applicationVersion": {
      "version": "${version}"
    }
  },
  "sap.ui": {
    "technology": "UI5",
    "icons": {},
    "deviceTypes": {
      "desktop": true,
      "tablet": true,
      "phone": true
    }
  },
  "sap.ui5": {
    "proxy": {
      "/odata": {
        "targetUri": "https://eco-ds-arabian-fal-dev-mc6enm46-dev-ppm-portal-final-srv.cfapps.us10-001.hana.ondemand.com/odata/v4/ContractService/",
        "changeOrigin": true,
        "secure": false
      }
    },
    "componentName": "com.fal.arabian",
    "rootView": {
      "viewName": "com.fal.arabian.view.Main",
      "type": "XML",
      "async": true,
      "id": "app"
    },
    "dependencies": {
      "minUI5Version": "1.97.0",
      "libs": {
        "sap.ui.core": {},
        "sap.m": {}
      }
    },
    "models": {
      "i18n": {
        "type": "sap.ui.model.resource.ResourceModel",
        "settings": {
          "bundleName": "com.fal.arabian.i18n.i18n"
        }
      },
      "employeeModel": {
        "type": "sap.ui.model.json.JSONModel",
        "settings": {
          "dataUrl": "http://localhost:3000/employees"
        }
      }
    },
    "routing": {
      "config": {
        "routerClass": "sap.m.routing.Router",
        "viewType": "XML",
        "viewPath": "com.fal.arabian.view",
        "controlId": "app",
        "controlAggregation": "pages",
        "async": true
      },
      "routes": [
        {
          "pattern": "",
          "name": "main",
          "target": "main"
        },
        {
          "pattern": "employeeTransferTable",
          "name": "employeeTransferTable",
          "target": "employeeTransferTable"
        }
      ],
      "targets": {
        "main": {
          "viewId": "main",
          "viewName": "Main"
        },
        "employeeTransferTable": {
          "viewId": "employeeTransferTable",
          "viewName": "EmployeeTransferTable"
        }
      }
    }
  }
}
